# Copy to .env — only PUBLIC values (they are embedded in the web bundle). Never put secrets (service_role, VAPID private key) here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# URL publique de la web app (liens d'invitation partageables) — ex. https://taskmate.vercel.app
EXPO_PUBLIC_WEB_URL=
# (optionnel) Clé VAPID publique pour le Web Push — générer avec `node scripts/generate-vapid.mjs`
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
# (optionnel) URL de la politique de confidentialité
EXPO_PUBLIC_PRIVACY_URL=
