# Copy to .env — only PUBLIC values (they are embedded in the web bundle). Never put secrets here
# (no service_role key, no database password, no VAPID private key).

# Production (projet Supabase « taskmate », région Sydney ap-southeast-2). En local : http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL=https://olftkozksanvnzlsvwrp.supabase.co
# Clé PUBLIQUE du projet : « Publishable key » (sb_publishable_…) ou clé « anon » — Supabase → Project Settings → API Keys.
# À saisir dans Vercel (Settings → Environment Variables), jamais dans git.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# URL publique de la web app (liens des notifications)
EXPO_PUBLIC_WEB_URL=https://taskmate-rho-nine.vercel.app
# (optionnel) Clé VAPID publique pour le Web Push — générable dans l'app : Réglages → Diagnostic
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
# (optionnel) URL de la politique de confidentialité
EXPO_PUBLIC_PRIVACY_URL=
