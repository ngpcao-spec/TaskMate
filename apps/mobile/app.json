{
  "expo": {
    "name": "TaskMate",
    "slug": "taskmate",
    "scheme": "taskmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "TaskMate uses the camera to scan the invite QR code."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E88F5"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.taskmate.family",
      "infoPlist": {
        "NSCameraUsageDescription": "TaskMate uses the camera to scan the invite QR code.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.taskmate.family",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}