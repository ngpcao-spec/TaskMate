{
  "expo": {
    "name": "TaskMate",
    "slug": "taskmate",
    "scheme": "taskmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#2B7A89"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.taskmate.family",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "app.taskmate.family",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "TaskMate",
      "shortName": "TaskMate",
      "description": "Vi\u1ec7c nh\u00e0 c\u1ee7a gia \u0111\u00ecnh \u2014 TaskMate",
      "themeColor": "#3C536C",
      "backgroundColor": "#9CB0C0",
      "lang": "vi"
    },
    "extra": {
      "eas": {}
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
